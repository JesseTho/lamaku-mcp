{
  "name": "lamaku-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for Lamakū, the University of Hawaiʻi's D2L Brightspace LMS — read course data and author announcements, content, assignments, grade items and discussions, with a FERPA guard on student identities",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "brightspace",
    "d2l",
    "valence",
    "lms",
    "lamaku",
    "hawaii",
    "claude"
  ],
  "license": "MIT",
  "author": "Jesse Thompson",
  "contributors": [
    "Sahil Dayal (mycourses-mcp, the upstream this is derived from)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JesseTho/lamaku-mcp.git"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "lamaku-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "login": "node dist/cli.js login",
    "status": "node dist/cli.js status",
    "doctor": "node dist/cli.js doctor",
    "tools": "node scripts/list-tools.mjs",
    "verify:privacy": "node scripts/verify-privacy.mjs",
    "verify:writes": "node scripts/verify-writes.mjs",
    "prepublishOnly": "npm run typecheck && npm test && tsc",
    "test": "node --test tests/*.test.mjs",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "pretest": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  }
}
