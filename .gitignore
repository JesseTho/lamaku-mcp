node_modules/
dist/
*.tsbuildinfo

# Credentials and session material — must never be committed.
# The real store lives in %APPDATA%/lamaku-mcp, but guard against strays.
.env
.env.*
!.env.example
*.session.json
session.enc
key
pseudonym-salt
browser-profile/
storage-state.json
cookies.json

# Watcher output — dated reports, run log, and the seen-courses baseline.
# Contains real course names, so it stays local.
reports/

# Downloaded course material
downloads/
*.pdf
*.docx
*.pptx

.DS_Store
Thumbs.db

# Impeccable design skill, installed with `npx impeccable install`.
# Vendored tooling rather than part of this product, so it stays local.
.github/skills/impeccable/
.github/agents/impeccable-*.agent.md
.github/hooks/impeccable.json

# Impeccable's own working directory. The contents are ignored rather than the
# directory, because git skips an ignored directory entirely and the negation
# below would never be reached.
.impeccable/*
# design.json is DESIGN.md's machine-readable half and ships with it, and the
# surface briefs record per-page strategy that outlives any one session.
!.impeccable/design.json
!.impeccable/surfaces/
