# Brightspace host. Defaults to lamaku.hawaii.edu when unset.
LAMAKU_HOST=lamaku.hawaii.edu

# FERPA guard. "strict" (default) replaces student names, usernames, emails and
# ids with stable pseudonyms before anything reaches the model. "off" emits
# real identities — only set it if you have decided that is acceptable.
LAMAKU_FERPA=strict

# Auth provider: "session" (browser session, works today) or "oauth"
# (requires a client ID/secret registered by a Brightspace admin).
LAMAKU_AUTH=session

# Which browser to drive for sign-in. Tries chrome, then msedge, then a
# Playwright-managed chromium. Set this to force one.
# LAMAKU_BROWSER=msedge

# Where download_topic_file writes files.
# Defaults to %APPDATA%/lamaku-mcp/downloads
# LAMAKU_DOWNLOAD_DIR=/path/to/your/downloads

# Pin an API version instead of using the instance's latest. Rarely needed.
# LAMAKU_LE_VERSION=1.96
# LAMAKU_LP_VERSION=1.62

# Sandbox course id used by scripts/verify-writes.mjs. That script creates and
# deletes real objects, so point it only at a course you can safely disturb.
# LAMAKU_SANDBOX=

# --- OAuth only: fill these in if UH ITS ever issues credentials ---
# LAMAKU_CLIENT_ID=
# LAMAKU_CLIENT_SECRET=
